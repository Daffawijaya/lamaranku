# Contoh, salin ke .env.local dan isi.
# Domain publik untuk canonical, sitemap, dan social preview (tanpa path).
NEXT_PUBLIC_SITE_URL=https://lamaranku.vercel.app
# Opsional: token verifikasi HTML Google Search Console, hanya nilainya.
GOOGLE_SITE_VERIFICATION=
# Gratis dari https://aistudio.google.com/apikey (masuk akun Google, tanpa kartu kredit)
GEMINI_API_KEY=
# Opsional, default gemini-3.8-flash (review mendalam dengan thinking; perlu kuota API)
GEMINI_MODEL=
# Opsional, model cadangan saat layanan utama lambat/sibuk. Default gemini-3.1-flash-lite.
# Isi kosong untuk menonaktifkan model cadangan.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Supabase (Dashboard > Project Settings > API): wajib untuk login + gate /cv-builder/isi
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
